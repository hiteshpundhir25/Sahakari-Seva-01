{
  "expo": {
    "name": "Sahakari Seva",
    "slug": "sahakari-seva",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coop.sahakariseva",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sahakari Seva needs your location to match you with nearby verified cooperative skilled professionals.",
        "NSCameraUsageDescription": "Sahakari Seva needs camera access to scan customer QR codes for job completion sign-off."
      }
    },
    "android": {
      "package": "com.coop.sahakariseva",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sahakari Seva matches verified local gig workers based on your device GPS coordinates."
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "504cfe7f-19cf-4e7c-abbb-81068396ecb8"
      }
    },
    "owner": "arijit_paul06"
  }
}
